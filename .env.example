APP_NAME=Motor de Inferencia Veterinario
ENVIRONMENT=development
POSTGRES_DB=vet_inference
POSTGRES_USER=vet_app
POSTGRES_PASSWORD=replace-with-local-password
DATABASE_URL=postgresql+psycopg://vet_app:replace-with-local-password@postgres:5432/vet_inference
JWT_SECRET=vet-local-dev-secret-change-before-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15
PASSWORD_RESET_DELIVERY=emailjs
FRONTEND_BASE_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=admin123
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin123
API_PORT=8000
API_INTERNAL_PORT=8000
POSTGRES_HOST_PORT=5433
PGADMIN_HOST_PORT=5050
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=500
BAYES_DEFAULT_PRIOR=0.20
BAYES_SMOOTHING_FACTOR=0.50
PROBABILITY_PRECISION=4
INFERENCE_HIGH_SCORE_THRESHOLD=7.0
INFERENCE_MODERATE_SCORE_THRESHOLD=4.0
SEED_DATA_PATH=app/seeds/clinical_reference_data.json
